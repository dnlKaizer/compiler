{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "mvn package",
            "type": "shell",
            "command": "mvn package",
            "options": {
                "cwd": "${workspaceFolder}/comcet"
            }
        },
        {
            "label": "run app",
            "type": "shell",
            "command": "java -cp target/comcet-1.0-SNAPSHOT.jar br.com.comcet.App -f teste.txt",
            "options": {
                "cwd": "${workspaceFolder}/comcet"
            }
        },
        {
            "label": "build run app",
            "dependsOn": [
                "mvn package",
                "run app"
            ],
            "dependsOrder": "sequence"
        }
    ]
}