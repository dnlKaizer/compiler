{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "mvn package",
            "type": "shell",
            "command": "mvn package",
            "options": {
                "cwd": "${workspaceFolder}/comcet"
            }
        },
        {
            "label": "run app",
            "type": "shell",
            "command": "mvn exec:java -Dexec.mainClass=\"br.com.comcet.App\" -Dexec.args=\"-f teste.pas\"",
            "options": {
                "cwd": "${workspaceFolder}/comcet"
            }
        },
        {
            "label": "build run app",
            "dependsOn": [
                "mvn package",
                "run app"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}